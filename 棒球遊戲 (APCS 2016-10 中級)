round = [input().split() for i in range(9)]
b = int(input())
all = 0
out = 0
runners = []

for j in range(1, 6):
    for i in range(9):
        if j >= len(round[i]):
            continue

        r = round[i][j]

        if r == 'FO' or r == 'SO' or r == 'GO':
            out += 1

            if out == b:
                break  # 跳出內層 i 迴圈

            if out % 3 == 0:
                runners = []

        else:
            if r == '1B':
                now = 1
            if r == '2B':
                now = 2
            if r == '3B':
                now = 3
            if r == 'HR':
                now = 4

            runners.append(0)
            new = []

            for x in runners:
                x += now
                if x >= 4:
                    all += 1
                else:
                    new.append(x)

            runners = new

    if out == b:
        break  # 跳出外層 j 迴圈

print(all)
