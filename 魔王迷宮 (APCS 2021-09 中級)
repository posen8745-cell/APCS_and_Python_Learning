n,m,k=map(int,input().split())
grid=[[0 for i in range(m)] for j in range(n)]
king=[list(map(int,input().split())) for i in range(k)]
while True:
    for i in range(k):
        grid[king[i][0]][king[i][1]]=1
        king[i][0]+=king[i][2];king[i][1]+=king[i][3]
    new=[]
    for i in range(k):
        if king[i][0]<0 or king[i][0]>=n or king[i][1]<0 or king[i][1]>=m:
            new.append(king[i])
            k-=1
            if k==0:
                break
    if k==0:
        break
    for i in new:
        king.remove(i)
    new=[]
    for i in range(k):
        if grid[king[i][0]][king[i][1]]==1:
            new.append(king[i])
            k-=1
            if k==0:
                break
    if k==0:
        for i in new:
            grid[i[0]][i[1]]=0
            king.remove(i)
        break
    for i in new:
        grid[i[0]][i[1]]=0
        king.remove(i)
bomb=0
for i in range(n):
    for j in range(m):
        if grid[i][j]==1:
            bomb+=1
print(bomb)
