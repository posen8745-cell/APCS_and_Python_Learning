r,c,k=map(int,input().split())  # 讀取列數、欄數、單字數

grid=[['*' for j in range(c)] for i in range(r)]  # 儲存真正的字母，供檢查衝突
show=[['*' for j in range(c)] for i in range(r)]  # 儲存最後要輸出的畫面

for i in range(k):  # 依序處理 k 個單字
    x,y,d,word=input().split()  # 讀取起點列、起點欄、方向、單字
    x=int(x)-1  # 列座標改成從 0 開始
    y=int(y)-1  # 欄座標改成從 0 開始
    d=int(d)  # 方向轉成整數：0 向右，1 向下

    ok=True  # 先假設這個單字可以放

    # 第一輪：只檢查，不修改盤面
    for j in range(len(word)):  # j 是字母在單字中的位置，從 0 開始
        nr=x+d*j  # 計算這個字母的列座標
        nc=y+(1-d)*j  # 計算這個字母的欄座標

        if not (0<=nr<r and 0<=nc<c):  # 如果超出盤面
            ok=False  # 整個單字不能放
            break  # 停止檢查這個單字

        if grid[nr][nc]!='*' and grid[nr][nc]!=word[j]:  # 已有字母，而且與新字母不同
            ok=False  # 整個單字不能放
            break  # 停止檢查這個單字

    # 第二輪：全部檢查通過，才真正放入
    if ok:
        for j in range(len(word)):  # 再走訪單字的每個字母
            nr=x+d*j  # 計算列座標
            nc=y+(1-d)*j  # 計算欄座標

            grid[nr][nc]=word[j]  # 保存真正的字母

            if j==0 or j==len(word)-1:  # 如果是第一個或最後一個字母
                show[nr][nc]=word[j]  # 輸出畫面顯示字母
            elif show[nr][nc]=='*':  # 如果是中間字母，而且這格還是空的
                show[nr][nc]='_'  # 輸出畫面改成底線

for row in show:  # 依序取出輸出畫面的每一列
    print(''.join(row))  # 將這列字元接起來輸出，不加空白
