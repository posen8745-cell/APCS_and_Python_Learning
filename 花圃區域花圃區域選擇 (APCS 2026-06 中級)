n,m,r,c=map(int,input().split())
guard=[list(map(int,input().split())) for i in range(n)]
site=[]
for i in range(n-r+1):
    for j in range(m-c+1):
        t_site=[i,j]
        legal=[]
        ok=True
        for k in range(r):
            for l in range(c):
                if guard[i+k][j+l]==-1:
                    ok=False
                    break
                legal.append(guard[i+k][j+l])
            if not ok:
                break
        if ok:
            flower=[]
            for k in legal:
                if k not in flower:
                    flower.append(k)
            t_site.append(len(flower))
            site.append(t_site)
mx=[]
mn=[]
for i in site:
    mx.append(i[2])
for i in site:
    if i[2]==max(mx):
        mn.append(i[0]+i[1])
for i in site:
    if i[0]+i[1]==min(mn) and i[2]==max(mx):
        print(*i)
        break
